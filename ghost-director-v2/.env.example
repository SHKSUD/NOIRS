# Leave empty to use the mock LLM (no key, no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock | anthropic  (default: anthropic if a key is set, else mock)
LLM_PROVIDER=

# Storyboard images: mock (default, free) | gemini (paid; needs GEMINI_API_KEY)
IMAGE_PROVIDER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
