# Leave empty to use the mock LLM (no key, no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock | anthropic  (default: anthropic if a key is set, else mock)
LLM_PROVIDER=

# Storyboard images: mock (default, free) | gemini (paid; needs GEMINI_API_KEY)
IMAGE_PROVIDER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Video clips: mock (default, free) | omni (Gemini Omni Flash, paid; needs GEMINI_API_KEY with billing
# and real image frames, i.e. IMAGE_PROVIDER=gemini). Draft 360p ~$0.023/s, final 720p ~$0.07/s.
VIDEO_PROVIDER=
OMNI_MODEL=gemini-omni-1.2-flash
